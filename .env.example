# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=openai            # openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides (defaults depend on LLM_PROVIDER)
# openai:    coder/reviewer = gpt-4.1,          planner/answer = gpt-4.1-mini
# anthropic: coder/reviewer = claude-sonnet-5-5, planner/answer = claude-haiku-5-5
CODER_MODEL=
REVIEWER_MODEL=
PLANNER_MODEL=
ANSWER_MODEL=

MAX_MESSAGES=12
EXEC_TIMEOUT_S=60
MAX_FILE_MB=25
MAX_ROWS=500000
TEAM_MODE=selector             # selector | roundrobin
USE_DOCKER=true                # falls back to local sandbox/ if Docker is not running
